# =============================================================================
# 대시보드 서버 환경변수 템플릿 — dashboard/.env 로 복사해 사용. .env 는 커밋하지 않는다.
# 셸 환경변수가 .env 보다 우선한다.
# =============================================================================

# ---- 서버 ----
DASHBOARD_BIND_ADDR=0.0.0.0
DASHBOARD_PORT=8765
# 코드 변경 시 자동 재시작(개발용)
DASHBOARD_RELOAD=false
LOG_LEVEL=INFO

# ---- 데이터 소스 ----
# supabase = 서버가 secret 키로 ppe_events / ppe-evidence 조회, sample = 브라우저에서 생성하는 샘플 데이터(오프라인)
DASHBOARD_DATA_SOURCE=supabase

# ---- 접근 토큰 (SYS-SEC-01) ----
# supabase 모드 필수, 16자 이상. 처음 http://<주소>/?token=<값> 으로 열면 쿠키로 저장된다(12시간).
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_ACCESS_TOKEN=

# ---- Supabase (DASHBOARD_DATA_SOURCE=supabase 일 때) ----
SUPABASE_URL=
# secret(sb_secret_…) 키. RLS 를 우회하므로 이 키로 ppe_events / ppe-evidence 를 읽고 쓸 수 있다.
# 서버(대시보드 조회)와 python -m seed(가데이터 업로드)가 함께 쓴다. 브라우저로는 내려가지 않는다.
# .env 는 gitignore 대상 — 키 값을 이 example 파일이나 다른 커밋 파일에 넣지 않는다.
SUPABASE_SERVICE_KEY=
# (선택) 운영/Docker 에서는 키를 파일·secret 으로 두고 경로만 적을 수 있다. 설정되면 위 값보다 우선.
SUPABASE_SERVICE_KEY_FILE=
SUPABASE_EVENTS_TABLE=ppe_events
SUPABASE_STORAGE_BUCKET=ppe-evidence
DASHBOARD_SIGNED_URL_EXPIRES_S=120
# 실시간 토글 폴링 주기(초)
DASHBOARD_LIVE_INTERVAL_S=15
