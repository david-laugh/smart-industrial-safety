# =============================================================================
# 대시보드 서버 환경변수 템플릿 — dashboard/.env 로 복사해 사용. .env 는 커밋하지 않는다.
# 셸 환경변수가 .env 보다 우선한다.
# =============================================================================

# ---- 서버 ----
DASHBOARD_BIND_ADDR=0.0.0.0
DASHBOARD_PORT=8765
# 코드 변경 시 자동 재시작(개발용)
DASHBOARD_RELOAD=false
LOG_LEVEL=INFO

# ---- 데이터 소스 ----
# supabase = 실제 ppe_events / ppe-evidence 조회, sample = 브라우저에서 생성하는 샘플 데이터(오프라인)
DASHBOARD_DATA_SOURCE=supabase

# ---- Supabase (DASHBOARD_DATA_SOURCE=supabase 일 때만) ----
SUPABASE_URL=
# anon(publishable) 키만 허용. service_role / secret 키를 넣으면 서버가 시작을 거부한다.
SUPABASE_ANON_KEY=
SUPABASE_EVENTS_TABLE=ppe_events
SUPABASE_STORAGE_BUCKET=ppe-evidence
DASHBOARD_SIGNED_URL_EXPIRES_S=120

# ---- 가데이터 업로드(python -m seed) 전용 — 대시보드 서버는 읽지 않음 ----
# dev 프로젝트의 service_role 키를 파일로 두고 경로만 적는다(권장). 키 값 커밋 금지.
SUPABASE_SERVICE_KEY_FILE=
