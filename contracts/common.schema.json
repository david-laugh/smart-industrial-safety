{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ppe-safety.local/contracts/common.schema.json",
  "title": "Common definitions",
  "description": "모든 계약 스키마가 공유하는 공통 타입. 단독으로 인스턴스를 검증하는 용도가 아니다.",
  "$defs": {
    "schemaVersion": {
      "description": "계약 스키마 버전(SemVer). 메이저 1 고정, 마이너는 하위 호환 필드 추가 시 증가.",
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "uuid": {
      "description": "RFC 9562 UUID 문자열(소문자). event_id 는 UUIDv7 권장.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "description": "RFC 3339 UTC 시각. 반드시 'Z' 접미사를 사용하고 로컬 오프셋을 쓰지 않는다.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "deviceId": {
      "description": "카메라 장치 식별자. 소문자, 숫자, 하이픈.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "bootId": {
      "description": "MCU 부팅마다 새로 생성하는 32비트 난수(hex 8자리). 재부팅으로 frame_seq/mcu_uptime_ms 가 초기화되는 것을 구별한다.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "frameSeq": {
      "description": "부팅 단위 프레임 순번(uint32).",
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "mcuUptimeMs": {
      "description": "MCU 부팅 이후 경과 시간(ms, 단조 증가). 벽시계 시각이 아니다.",
      "type": "integer",
      "minimum": 0
    },
    "ppeStatus": {
      "description": "PPE 착용 상태. WORN=착용 확인, MISSING=미착용 확인, UNKNOWN=판정 불가(가림, 저신뢰도, 영역 밖 등).",
      "type": "string",
      "enum": ["WORN", "MISSING", "UNKNOWN"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ppeItemResult": {
      "description": "PPE 항목 하나(안전모 또는 안전조끼)의 판정.",
      "type": "object",
      "required": ["status", "confidence"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/ppeStatus" },
        "confidence": {
          "description": "status 에 대한 신뢰도. UNKNOWN 이고 근거 검출이 없으면 null.",
          "anyOf": [{ "$ref": "#/$defs/confidence" }, { "type": "null" }]
        }
      }
    },
    "bboxNormalized": {
      "description": "원본 이미지 크기 기준 0~1 정규화 좌표. 원점은 좌상단.",
      "type": "object",
      "required": ["x_min", "y_min", "x_max", "y_max"],
      "additionalProperties": false,
      "properties": {
        "x_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "y_min": { "type": "number", "minimum": 0, "maximum": 1 },
        "x_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "y_max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "imageDimensions": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4096 }
      }
    },
    "relativeImagePath": {
      "description": "EVENT_DATA_ROOT 기준 상대 경로. 절대 경로와 '..' 금지.",
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+\\.jpg$",
      "maxLength": 255
    },
    "modelInfo": {
      "description": "결과를 만든 추론 모델 식별 정보. 재현성과 감사 추적용.",
      "type": "object",
      "required": ["name", "version", "sha256", "input_width", "input_height", "runtime", "runtime_version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "input_width": { "type": "integer", "minimum": 32, "maximum": 2048 },
        "input_height": { "type": "integer", "minimum": 32, "maximum": 2048 },
        "runtime": { "type": "string", "enum": ["onnxruntime"] },
        "runtime_version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    }
  }
}
