# =============================================================================
# 환경변수 템플릿 — 값을 채운 사본(.env)은 절대 커밋하지 않는다.
# 숫자 기본값은 측정 전 초기값이며 docs/benchmark-plan.md 측정 후 조정한다.
# native/systemd 배포에서도 같은 변수명을 EnvironmentFile로 사용한다.
# =============================================================================

# ---- 이미지 (Compose 템플릿 전용, 구현 단계에서 확정) ----
EDGE_CORE_IMAGE=
CLOUD_SYNC_IMAGE=
GATEWAY_IMAGE=
INFERENCE_IMAGE=

# ---- 공통 ----
SITE_ID=
LOG_LEVEL=INFO
EVENT_DATA_ROOT=/data
TZ=UTC

# ---- Gateway (인터페이스 1, 2) ----
GATEWAY_BIND_ADDR=0.0.0.0
GATEWAY_PORT=8080
# JSON 형식 {"device_id": "token"} 대신 파일 경로 사용 권장. 토큰 값 커밋 금지.
GATEWAY_DEVICE_TOKENS_FILE=/run/secrets/device_tokens
GATEWAY_MAX_REQUEST_BYTES=1179648
GATEWAY_MAX_IMAGE_BYTES=1048576
GATEWAY_QUEUE_MAX_FRAMES=4
GATEWAY_QUEUE_MAX_BYTES=4194304
GATEWAY_PER_DEVICE_MAX_FPS=
GATEWAY_RETRY_AFTER_MS=1000
# 3-컨테이너 분리 배포에서만 사용
INFERENCE_SOCKET_PATH=/run/ppe/inference.sock

# ---- Inference (인터페이스 3) ----
INFERENCE_MODEL_PATH=/models/
INFERENCE_MODEL_SHA256=
ORT_INTRA_OP_THREADS=3
ORT_INTER_OP_THREADS=1
INFERENCE_PERSON_MIN_CONFIDENCE=
INFERENCE_PPE_MIN_CONFIDENCE=
INFERENCE_MIN_PERSON_BOX_PX=

# ---- PPE Decision (인터페이스 4) ----
PPE_POLICY_VERSION=0.0.0
PPE_DECISION_WINDOW_FRAMES=
PPE_DECISION_MIN_MISSING_FRAMES=
PPE_UNKNOWN_IS_VIOLATION=false
PPE_DEDUP_WINDOW_S=30
PPE_DEDUP_GRID=4x4
TIME_MAX_DEVICE_SKEW_MS=2000

# ---- Event Store ----
EVENT_STORE_DB_PATH=/data/outbox.db
EVENT_STORE_MAX_BYTES=
EVENT_LOCAL_RETENTION_DAYS=7

# ---- Cloud Sync (인터페이스 5) ----
SUPABASE_URL=
# 고권한 키: cloud-sync 전용. 파일/secret으로 주입 권장. 값 커밋 금지.
SUPABASE_SERVICE_KEY_FILE=/run/secrets/supabase_service_key
SUPABASE_EVENTS_TABLE=ppe_events
SUPABASE_STORAGE_BUCKET=ppe-evidence
SYNC_CONCURRENCY=1
SYNC_RETRY_BASE_S=2
SYNC_RETRY_MAX_S=300
SYNC_MAX_ATTEMPTS=
SYNC_HTTP_TIMEOUT_S=15

# ---- 모델 디렉터리 (호스트 경로, Compose 템플릿에서 /models로 읽기 전용 마운트) ----
MODEL_DIR=./models
